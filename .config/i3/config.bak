# This file has been auto-generated by i3-config-wizard(1).
# It will not be overwritten, so edit it as you like.
#
# Should you change your keyboard layout some time, delete
# this file and re-run i3-config-wizard(1).
#
# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference! ok thanks i3 

#: MOD KEY (Mod1 is alt, Mod4 is Win)
set $mod Mod4

#: Alt isn't set by default and i will reserve it for special cases
#: This is because alt could have been i3 mod key
set $alt Mod1 

#: FONTS

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Hack Nerd Font Mono 12

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
# font pango:Adwaita Mono 12


#: START I3 ENVIRONMENT (i won't rewrite these comments)

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3


#: I3 RELOAD, REFRESH, EXIT, SHUTDOWN

#: reload the configuration file (only reloads this file, not whole session)
bindsym $mod+Shift+c reload
#: restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
#: exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"
#: shutdown (casual and keyboard)
bindsym $mod+shift+u exec "i3-nagbar -t warning -m 'You pressed the shutdown shortcut. Do you really want to shutdown?' -B 'Yes, shutdown' 'i3-msg exec shutdown now'"
bindsym $mod+shift+$alt+u exec shutdown now

#: I3 STATUS BAR

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
        status_command i3status -c ~/.config/i3/i3status.conf 
	
	#: Bar Colors	

	colors {
		# defaults
		background 		#34005e
		statusline 		#808080
		separator  		#404040

		# focused bar
		#focused_background 	#000000
		focused_statusline	#a0a0a0
		focused_separator	#777777

		# workspace	   border  backgr  text
		focused_workspace  #6500e1 #ffc743 #34005e
		active_workspace   #34005e #f8238c #808080 
		inactive_workspace #34005e #3e008b #808080 
		urgent_workspace   #ff3d00 #ff0004 #34005e 

	}
}

#: Window Colors 

# class  		border  backgr  text  indicator child_border
client.focused		#34005e #6500e1 #ffffff #f8238c #285577
client.unfocused	#34005e #3e008b #808080 #f8238c #285577	
client.focused_inactive	#34005e #ffc743 #34005e #ffc743 #285577
client.urgent		#ff3d00 #ff0004 #34005e #34005e #285577
client.placeholder	#000000 #0c0c0c #ffffff #000000 #0c0c0c

# border is around entire window
# backgr is rectangle above window
# text is window name
# indicator is thin bar on right / bottom of window. You will barely ever notice it
# child border is around entire child window

#: WORKSPACE INIT AND KEYBINDS

#: Initialize Workspace Variables
set $ws1 "1 "
set $ws2 "2 󰖟"
set $ws3 "3 󰧮"
set $ws4 "4 "
set $ws5 "5 ♫"
set $ws6 "6 "
set $ws7 "7 "
set $ws8 "8  "
set $ws9 "9  "
set $ws10 "10 🖳"

# if i ever make up my mind, i can use these for dedicated workspaces
#          


#: Access Workspaces with Keybinds
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+minus scratchpad show

#: Move Container to Workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10
bindsym $mod+shift+minus move scratchpad


#: WORKSPACE ORIENTATION

#: FULLSCREEN CONTAINERS

#: Toggle Fullscren on Focused
bindsym $mod+f fullscreen toggle


#: TILING CONTAINERS

#: Split Orientation

#: set orientation to split, or toggle horizontal/vertical arrangement 
bindsym $mod+e layout toggle split
#: These other 2 are unnecessary and sorta bugy after lots of use.
#: Going to recycle the keybinds for other uses
#: set behavior to make added containers tile horizontally (rightward) 
#bindsym $mod+b split horizontal
#: set behavior to make added containers tile vertically (downward) 
#bindsym $mod+v split vertical

#: resize window function with keys (could just use mouse at seam)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

#: Stacked and Tabbed Orientations

#: set orientaiton to stack windows with vertically offset title bars
bindsym $mod+s layout stacking
#: set orientaiton to tab windows with horizontally offset title bars
bindsym $mod+t layout tabbed


#: FLOATING CONTAINERS

#: Toggle Floating Containers
bindsym $mod+Shift+space floating toggle

#: change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

#: hold mod to drag floating window
floating_modifier $mod

#: could also just drag floating window from title bar
tiling_drag modifier titlebar


#: CONTAINERS AND FOCUS

#: Kill Focused Container
bindsym $mod+shift+q kill

#: Change Focus
 
#: vi-style
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

#: arrow keys
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

#: Move Focused Window

#: vi-style
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

#: arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# focus the parent container
#bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child


#: OPEN PROGRAMS

#: Start a Terminal
#bindsym $mod+Return exec i3-sensible-terminal
bindsym $mod+Return exec kitty

# Start dmenu (a program launcher)
#bindsym $mod+d exec --no-startup-id dmenu_run

# A more modern dmenu replacement is rofi:
# bindcode $mod+40 exec "rofi -modi drun,run -show drun"

#: many rofi commands that do work are not valid here
#: it cannot parse multiple modes as in its own example lmao
bindsym $mod+d exec rofi -show drun


#: START OF OTHER PERSONAL ADDITIONS

#: some i3 config i added
focus_follows_mouse no
mouse_warping none
popup_during_fullscreen smart

#: software shortcuts
bindsym $mod+backslash exec vivaldi
bindsym $mod+bracketright exec discord
bindsym $mod+bracketleft exec librewolf
bindsym $mod+i exec kitty nvim
bindsym $mod+o exec okular

#: need to find way to fix display for hdmi adding / removing and bind to mod+p
#: mod+p is the shortcut for media key F7
# bindsym $mod+p exec 


#bindsym $mod+v exec librepods
# bindsym $mod+bracketright exec zen-browser

# not all software is keybindable here. 
# notably obsidian and blueman, but some cli too


#: GAPS (because mouse be in the way hella)
#: Inner gaps for all windows: space between two adjacent windows (or split containers).
gaps inner 4

#: Outer gaps for all windows: space along the screen edges.
gaps outer 2


#: Background Apps

#: xscreensaver
exec xscreensaver -no-splash

#: Set Brightness (to avoid flashbang)
#exec brightnessctl set 20%
#: no longer necessary, ly allows for brightness changes from there
#: keep this here in case it breaks, though

#: Display Resolution (set here just in case)
exec_always xrander --output eDP-1 --mode 1920x1080 --scale 1.5

workspace 10 output HDMI-1


#: Turn on Nighlight
exec redshift -c ~/.config/redshift/redshift.conf &

#: Start SXHKD for Keybinds (in the config file)
exec sxhkd -c ~/.config/sxhkd/sxhkdrc &

#: Display Wallpaper (if you wish to change it, please rename the file)
#exec_always feh --bg-fill ~/Pictures/wallpaper.png
exec_always feh --bg-fill ~/Pictures/Wallpapers/wallpaper
# i really should make a script to run to get wallpaper sometime
# this way is inconvenient

#: Start Compositor (transparency and fade in)
exec_always picom -f

#: Start Automounter
exec udiskie -c ~/.config/udiskie/config.yml

#: Start Kanata (Smart Caps Lock) 
exec kanata -c ~/.config/kanata/kanata.kbd &

#: Start Syndaemon (less accidental clicks)
exec syndaemon -i 0.5 -t -K -d

#: Start speech-dispatcher (tts)
exec speech-dispatcher -d &
