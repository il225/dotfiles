#!/sbin/bash

# Requirements (afaict)
# - feh package and some picture to display in...
# - the path ~/Pictures/wallpapers/wallpaper using...
# - pictures following the naming scheme "wallpaper01. wallpaper02."
# (file extentions can be anything so long as name is unique)
# - also the file ~/.fehbg as seen in the repo.

# I use `exec-always feh --bg-fill ~/Pictures/wallpapers/wallpaper`
# in my i3 config, but that might not be relevant to you

# other files present are wallpaper (no ext) and wallpaper.<ext> (no number),
# the former is the active wallpaper file in ~/config/i3/config, and the
# latter is the default wallpaper

# There is a tool I made to format a directory to meet the format outlined
# see bulk_renamer BUT DO NOT BLINDLY RUN IT ON A DIRECTORY
# It is very naive at the moment, so reminder to use backups of directories.

cd ~/Pictures/Wallpapers || exit # if no directory, leave

# Random Non-Default Wallpaper Flag
if [ "$1" == "-r" ]; then
	possible=$(ls | grep -c .)
	number=$((1+$RANDOM%($possible-2)))
  # works with the format; place value should work up to 99 easy
  # if you have 100 wallpapers simultaneously, rethink your life
	if [ $number -lt 10 ]; then
		number=0$number
	fi
  wp=$(echo wallpaper"$1".*)
  feh --bg-scale "$wp"
# Set Wallpaper by Number
elif [ "$#" -gt 0 ]; then
  wp=$(echo wallpaper"$1".*)
  feh --bg-scale "$wp"
# Set Default Wallpaper
else
  wp=$(echo wallpaper"$1".*)
  feh --bg-scale "$wp"
fi
