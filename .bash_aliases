alias 'docs'='cd ~/Documents/'
alias 'txt'='cd ~/Documents/txt/'
alias 'repo'='cd ~/Repos/'
alias 'pics'='cd ~/Pictures/'
alias 'art'='cd ~/Pictures/Art'
alias 'vim'='nvim'
alias 'later'='nvim ~/Documents/txt/additions.txt'
alias 'idea'='nvim ~/Documents/txt/ideas.txt'
# vim habits
alias ':q'='exit'
# i HATE mouse movement events
alias 'xev'='xev -event keyboard'
# this one is broken
alias 'hdmi'='xrandr --output HDMI-1 --auto --right-of eDP-1'
